[Unit]
Description=Director Hub V0.5 single MCP service (13 fixed routed tools)
After=network-online.target director-vps-control.service director-power-mcp.service
Wants=network-online.target
Requires=director-power-mcp.service

[Service]
Type=simple
User=directorpower
Group=directorpower
WorkingDirectory=/opt/comfyui-director-hub
Environment=DIRECTOR_HUB_GPU_PATH_FILE=/etc/comfyui-director-hub-gpu-path
ExecStart=/opt/comfyui-director-control/.venv/bin/python /opt/comfyui-director-hub/hub_app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
