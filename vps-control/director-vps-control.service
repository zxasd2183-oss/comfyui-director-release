[Unit]
Description=ComfyUI Director VPS read-only controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=directorctl
Group=directorctl
WorkingDirectory=/opt/comfyui-director-control
EnvironmentFile=/etc/comfyui-director-control.env
ExecStart=/opt/comfyui-director-control/.venv/bin/python /opt/comfyui-director-control/app.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/comfyui-director-control

[Install]
WantedBy=multi-user.target
