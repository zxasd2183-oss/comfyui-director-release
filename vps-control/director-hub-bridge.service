[Unit]
Description=Director Hub private route bridge (8899 to MCP 8898)
After=network-online.target director-hub-mcp.service
Requires=director-hub-mcp.service

[Service]
Type=simple
User=directorpower
Group=directorpower
WorkingDirectory=/opt/comfyui-director-hub
Environment=DIRECTOR_HUB_TOKEN_FILE=/etc/comfyui-director-hub.token
ExecStart=/opt/comfyui-director-control/.venv/bin/python /opt/comfyui-director-hub/hub_bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
