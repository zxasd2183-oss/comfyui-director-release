[Unit]
Description=Director Studio V0.8 private real-time supervision console (SSH-only)
After=network-online.target director-hub-mcp.service
Wants=network-online.target director-hub-mcp.service

[Service]
Type=simple
User=directorstudio
Group=directorstudio
WorkingDirectory=/opt/director-studio
ExecStart=/usr/bin/python3 -B /opt/director-studio/studio_server.py
Environment=DIRECTOR_STUDIO_DB=/var/lib/director-studio/studio.sqlite
Environment=DIRECTOR_STUDIO_HUB_PORT=8898
StateDirectory=director-studio
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
